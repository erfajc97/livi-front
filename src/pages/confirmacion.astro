---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PaymentConfirmation from '@/app/features/order/components/PaymentConfirmation';
---

<BaseLayout title="Pedido confirmado — LIVI" description="Tu pedido ha sido confirmado exitosamente" robots="noindex,nofollow">
  <div class="min-h-screen bg-bg flex flex-col pt-[40px]">

    <header class="w-full flex justify-center items-center py-4 mt-6">
      <a href="/">
        <img src="/logo-livi.svg" alt="LIVI" class="h-8" />
      </a>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 md:pb-16">
      <PaymentConfirmation client:load />
    </main>
  </div>
</BaseLayout>
