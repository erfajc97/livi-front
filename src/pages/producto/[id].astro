---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { fetchProducts, fetchProductById } from '@/app/tanstack-queries/productsQuery';
import ProductGallery from '@/app/features/product/components/ProductGallery.astro';
import ProductPurchaseOptions from '@/app/features/product/components/ProductPurchaseOptions';
import ProductShippingTimeline from '@/app/features/product/components/ProductShippingTimeline.astro';
import ProductDescriptionBlock from '@/app/features/product/components/ProductDescriptionBlock.astro';
import ProductReviewsCarousel from '@/app/features/product/components/ProductReviewsCarousel';
import ExploreCategoriesCarousel from '@/app/features/product/components/ExploreCategoriesCarousel';

export async function getStaticPaths() {
  const data = await fetchProducts({ limit: 100 });
  return data.content.map((product) => ({
    params: { id: product.id },
  }));
}

const { id } = Astro.params;
const product = await fetchProductById(id);

if (!product) {
  return Astro.redirect('/404');
}

const allProductsRes = await fetchProducts({ limit: 12 });
const relatedProducts = allProductsRes.content.filter(p => p.id !== product.id);
---

<PublicLayout title={`${product.name} — NönDecants`}>
  <div class="bg-white min-h-screen pt-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 pb-10">
      {/* Breadcrumb */}
      <nav class="mb-4 text-sm font-bold text-gray-500 flex items-center gap-2">
        <a href="/" class="hover:text-black transition-colors">Inicio</a>
        <span class="text-gray-300">/</span>
        <a href="/catalogo" class="hover:text-black transition-colors">Perfumes</a>
        <span class="text-gray-300">/</span>
        <span class="text-black">{product.name}</span>
      </nav>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 mt-6">
        <div class="max-w-full overflow-hidden">
          <ProductGallery images={product.images?.length ? product.images : [product.image].filter(Boolean)} name={product.name} />
        </div>
        <div>
          <ProductPurchaseOptions product={product} client:load />
        </div>
      </div>

      <ProductShippingTimeline />
      <ProductDescriptionBlock description={product.description} />
      <ProductReviewsCarousel name={product.name} client:visible />
    </div>

    {/* Explore Categories — React carousel */}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-20">
      <ExploreCategoriesCarousel products={relatedProducts} client:visible />
    </div>
  </div>
</PublicLayout>
