---
export const prerender = false;

import PublicLayout from '@/layouts/PublicLayout.astro';
import { fetchProducts, fetchProductById } from '@/app/tanstack-queries/productsQuery';
import ProductDetailIsland from '@/app/features/product/components/ProductDetailIsland';
import ProductShippingTimeline from '@/app/features/product/components/ProductShippingTimeline.astro';
import ProductEditorial from '@/app/features/product/components/ProductEditorial.astro';
import ExploreCategoriesCarousel from '@/app/features/product/components/ExploreCategoriesCarousel';

const { id } = Astro.params;
const product = await fetchProductById(id!);

if (!product) {
  return Astro.redirect('/404');
}

// Relacionados: misma categoría, distinta marca (productos de la categoría
// de otras casas). Si el producto no trae categoría, no se muestra el carrusel.
const relatedProducts = product.categoryId
  ? (await fetchProducts({ categoryId: product.categoryId, limit: 12 })).content
      .filter((p) => p.id !== product.id && (product.marcaId == null || p.marcaId !== product.marcaId))
  : [];
---

<PublicLayout title={`${product.name} — NönDecants`}>
  <div class="bg-bg min-h-screen pt-10">
    <div class="max-w-[1400px] mx-auto px-6 md:px-14 py-6 pb-10">
      {/* Breadcrumb */}
      <nav class="mb-4 font-body text-[11px] tracking-[0.04em] text-text-muted flex items-center gap-2">
        <a href="/" class="hover:text-text transition-colors">Inicio</a>
        <span>·</span>
        <a href={product.bajoPedido ? '/bajo-pedido' : '/catalogo/perfumes'} class="hover:text-text transition-colors">
          {product.bajoPedido ? 'Bajo Pedido' : 'Perfumes'}
        </a>
        <span>·</span>
        <span class="text-text">{product.name}</span>
      </nav>

      <ProductDetailIsland product={product} client:load />

      {/* Línea de tiempo 24-72h: solo para productos en stock (no bajo pedido) */}
      {!product.bajoPedido && <ProductShippingTimeline />}
    </div>

    {/* Secciones editoriales (perfil olfativo · carácter/ocasión · firma · promesas) */}
    <ProductEditorial product={product} />

    {/* Relacionados — misma categoría, otras casas */}
    <div class="max-w-[1400px] mx-auto px-6 md:px-14 pb-20 pt-16">
      <ExploreCategoriesCarousel products={relatedProducts} client:visible />
    </div>
  </div>
</PublicLayout>
