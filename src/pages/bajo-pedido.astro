---
import PublicLayout from '@/layouts/PublicLayout.astro';
---

<PublicLayout
  title="Bajo Pedido — NönDecants"
  description="Solicita perfumes personalizados bajo pedido en NönDecants."
>
  <section class="min-h-screen max-w-7xl mx-auto px-4 py-16">
    <h1 class="font-heading text-4xl md:text-5xl text-[--color-text] uppercase tracking-widest mb-8">
      Bajo Pedido
    </h1>
    <p class="text-[--color-text-muted] text-lg leading-relaxed max-w-2xl">
      Si no encuentras el perfume que buscas en nuestro catálogo, podemos traerlo especialmente para ti.
    </p>
  </section>
</PublicLayout>
