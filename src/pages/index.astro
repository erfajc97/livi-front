---
export const prerender = false;

import PublicLayout from '@/layouts/PublicLayout.astro';
import HeroSection from '@/app/features/landing/components/sections-home/HeroSection.astro';
import Home from '@/app/features/landing/pages/home/Home';
import {
  absoluteImageUrl,
  homepageBannersJsonLd,
  websiteJsonLd,
} from '@/app/helpers/seoMeta';
import { fetchVisibleBanners } from '@/app/tanstack-queries/bannersQuery';

const banners = await fetchVisibleBanners();
const firstBannerImage = absoluteImageUrl(banners[0]?.imageUrl || banners[0]?.image);
---

<PublicLayout
  title="Pañaleras y mochilas de cuero premium en Ecuador | LIVI"
  description="Pañaleras y mochilas de cuero genuino, hechas a mano en Ecuador. For modern parenthood. Envío nacional 24–72 h."
  ogImage={firstBannerImage ?? '/og-image.jpg'}
  jsonLd={[websiteJsonLd(), homepageBannersJsonLd(banners)]}
>
  <h1 class="sr-only">Pañaleras y mochilas de cuero premium en Ecuador</h1>
  {/* Hero editorial LIVI (ref. PDF pág. 14). Los banners del admin quedan
      disponibles, pero el home usa este panel fijo de marca. */}
  <HeroSection />
  <Home client:load />
</PublicLayout>
