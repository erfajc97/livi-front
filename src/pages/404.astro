---
import PublicLayout from '@/layouts/PublicLayout.astro';
---

<PublicLayout
  title="Página no encontrada — NonDecants"
  description="La página que estás buscando no existe o ha sido movida."
>
  <div class="min-h-[60vh] flex flex-col items-center justify-center px-6 py-12 text-center md:py-20">
    <h1 class="font-heading text-8xl md:text-9xl text-[--color-accent] mb-4">
      404
    </h1>
    <h2 class="font-heading text-2xl md:text-4xl text-[--color-text] mb-6">
      Página no encontrada
    </h2>
    <p class="text-[--color-text-muted] max-w-md mb-10 text-lg">
      Lo sentimos, la página que estás buscando no existe, ha sido eliminada o su nombre ha cambiado.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center bg-[--color-accent] text-black px-8 py-3.5 font-medium uppercase tracking-widest hover:bg-white transition-colors duration-300"
    >
      Volver al inicio
    </a>
  </div>
</PublicLayout>
