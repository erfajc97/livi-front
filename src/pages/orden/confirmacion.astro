---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import OrderConfirmationIsland from '@/app/features/order/components/OrderConfirmationIsland';
---

<BaseLayout title="Confirmación de orden — NönDecants">
  <div class="flex min-h-screen flex-col bg-bg pt-6">
    <header class="flex w-full items-center justify-center py-6">
      <a href="/" aria-label="NönDecants — Inicio">
        <img src="/logonondecants.png" alt="NönDecants" width={543} height={127} class="h-9 w-auto md:h-11" />
      </a>
    </header>

    <main class="mx-auto w-full max-w-2xl flex-1 px-6 pb-20 sm:px-6">
      <OrderConfirmationIsland client:load />
    </main>
  </div>
</BaseLayout>
