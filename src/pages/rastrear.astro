---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ShipmentTracker from '@/app/features/order/components/ShipmentTracker';
---

<BaseLayout title="Rastrear Pedido — NonDecants" description="Rastrea el estado de tu envío con Servientrega." robots="noindex,nofollow">
  <div class="min-h-screen bg-[url('/footer.png')] bg-[--color-bg] bg-repeat bg-center flex flex-col pt-[40px]">

    <header class="w-full flex justify-center items-center py-4 mt-6">
      <a href="/">
        <img src="/logo.svg" alt="NönDecants" class="h-8" />
      </a>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 md:pb-16">
      <ShipmentTracker client:load />
    </main>
  </div>
</BaseLayout>
