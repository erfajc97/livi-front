---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Catalog from '@/app/features/catalog/Catalog';

const robots = Astro.url.search ? 'noindex,follow' : 'index,follow';
---

<PublicLayout
  title="Catálogo de perfumes originales en Ecuador | NonDecants"
  description="Explora perfumes árabes, nicho y de diseñador 100 % originales. Decants y frascos sellados. Envío a todo Ecuador."
  canonical="/catalogo"
  robots={robots}
>
  <div class="bg-bg min-h-screen">
    <div class="border-t border-border"></div>
    <Catalog client:load bannerTitle="Catálogo" bannerDescription="Explora toda nuestra colección de perfumes" />
  </div>
</PublicLayout>
