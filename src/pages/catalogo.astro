---
export const prerender = false;

import PublicLayout from '@/layouts/PublicLayout.astro';
import Catalog from '@/app/features/catalog/Catalog';
import CatalogProductIndex from '@/app/features/catalog/components/CatalogProductIndex.astro';
import { fetchProducts } from '@/app/tanstack-queries/productsQuery';

const robots = Astro.url.search ? 'noindex,follow' : 'index,follow';
// El API limita `limit` a 100 — pedir más devuelve 400 y el índice caía al fallback.
const indexed = await fetchProducts({ limit: 100, page: 1 });
---

<PublicLayout
  title="Tienda — Pañaleras y mochilas de cuero | LIVI"
  description="Explora pañaleras, mochilas y accesorios de cuero premium LIVI. Hechos a mano en Ecuador. Envío a todo el país."
  canonical="/catalogo"
  robots={robots}
>
  <div class="bg-bg min-h-screen">
    <div class="border-t border-border"></div>
    <Catalog client:load bannerTitle="Tienda" bannerDescription="Explora toda la colección LIVI" />
    <CatalogProductIndex products={indexed.content} />
  </div>
</PublicLayout>
