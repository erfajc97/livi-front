---
import PublicLayout from '@/layouts/PublicLayout.astro';
import LegalLayout from '@/app/features/landing/pages/legal/LegalLayout.astro';
import { SITE_FAQ } from '@/app/features/landing/data/faqItems';
import { breadcrumbJsonLd, faqPageJsonLd } from '@/app/helpers/seoMeta';
---

<PublicLayout
  title="Preguntas frecuentes | LIVI"
  description="Productos, envíos en Ecuador, horarios de despacho y pagos. Respuestas claras de LIVI."
  canonical="/faq"
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Inicio', href: '/' },
      { name: 'Preguntas frecuentes', href: '/faq' },
    ]),
    faqPageJsonLd(SITE_FAQ),
  ]}
>
  <LegalLayout
    eyebrow="Ayuda"
    title="Preguntas frecuentes"
    intro="Materiales, colores, envíos en Ecuador, horario de despacho y pagos. Si no está aquí, escríbenos por WhatsApp."
  >
    {SITE_FAQ.map((item) => (
      <>
        <h2>{item.question}</h2>
        <p>{item.answer}</p>
      </>
    ))}
    <p>
      Condiciones de compra en los <a href="/terminos">términos</a>.
    </p>
  </LegalLayout>
</PublicLayout>
