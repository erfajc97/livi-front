---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheckoutIsland from '@/app/features/checkout/components/Checkout';

export const prerender = false; // Checkout requires client side checking or SSR, Astro defaults to SSG
---

<BaseLayout title="Checkout — LIVI" description="Finaliza tu compra de forma segura" robots="noindex,nofollow">
  <div class="flex min-h-screen flex-col bg-bg pt-6">
    <header class="flex w-full flex-col items-center gap-3 py-6">
      <a href="/" aria-label="LIVI — Inicio">
        <img src="/logo-livi.svg" alt="LIVI" width={543} height={127} class="h-9 w-auto md:h-11" />
      </a>
      <div class="flex items-center justify-center gap-4" aria-hidden="true">
        <span class="h-px w-12 bg-accent/30"></span>
        <img src="/caballito-burgundy.png" alt="" width="26" height="21" class="h-[21px] w-[26px] object-contain" />
        <span class="h-px w-12 bg-accent/30"></span>
      </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-6 pb-12 md:px-14 md:pb-20">
      {/* Container blanco emulando el popup redondeado que muestra el mockup */}
      <CheckoutIsland client:load />
    </main>
  </div>
</BaseLayout>
