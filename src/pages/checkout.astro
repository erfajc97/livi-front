---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheckoutIsland from '@/app/features/checkout/components/Checkout';

export const prerender = false; // Checkout requires client side checking or SSR, Astro defaults to SSG
---

<BaseLayout title="Checkout — NönDecants" description="Finaliza tu compra de forma segura">
  <div class="flex min-h-screen flex-col bg-bg pt-6">
    <header class="flex w-full items-center justify-center py-6">
      <a href="/" aria-label="NönDecants — Inicio">
        <img src="/logonondecants.png" alt="NönDecants" width={543} height={127} class="h-9 w-auto md:h-11" />
      </a>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-6 pb-12 md:px-14 md:pb-20">
      {/* Container blanco emulando el popup redondeado que muestra el mockup */}
      <CheckoutIsland client:load />
    </main>
  </div>
</BaseLayout>
