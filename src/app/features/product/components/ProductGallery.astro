---
interface Props {
  images: string[];
  name: string;
}

const { images, name } = Astro.props;
const list = images.length > 0 ? images : [];
---

{list.length === 0 ? (
  <div class="aspect-square bg-surface-raised flex items-center justify-center text-text-muted rounded-xl">
    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75">
      <rect x="3" y="3" width="18" height="18" rx="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>
  </div>
) : (
  <div class="flex flex-col-reverse sm:flex-row gap-3 sm:gap-4">
    {/* Thumbnails — horizontal on mobile, vertical on sm+ */}
    {list.length > 1 && (
      <div class="flex sm:flex-col gap-2 sm:gap-3 shrink-0 overflow-x-auto sm:overflow-x-visible">
        {list.map((img, i) => (
          <button
            class={`thumbnail-btn w-16 h-20 sm:w-20 sm:h-24 shrink-0 overflow-hidden border-2 rounded-xl transition-all ${
              i === 0 ? 'border-black' : 'border-transparent hover:border-border'
            }`}
             data-index={i}
             data-src={img}
          >
            <img src={img} alt={`${name} ${i + 1}`} class="w-full h-full object-cover rounded-lg" />
          </button>
        ))}
      </div>
    )}

    {/* Main image */}
    <div
      class="flex-1 overflow-hidden bg-surface-raised rounded-2xl flex items-center justify-center min-h-[320px] sm:min-h-[420px] md:min-h-[500px]"
    >
      <img
        id="main-product-image"
        src={list[0]}
        alt={name}
        class="max-w-full max-h-[320px] sm:max-h-[420px] md:max-h-[500px] object-contain transition-opacity duration-300"
      />
    </div>
  </div>
)}

<script>
  // Script para manejar el cambio de imágenes interactivo
  const mainImage = document.getElementById('main-product-image') as HTMLImageElement;
  const thumbnails = document.querySelectorAll('.thumbnail-btn');

  thumbnails.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const src = target.getAttribute('data-src');
      
      if (src && mainImage) {
        // Opacidad para dar efecto de transición
        mainImage.style.opacity = '0.5';
        setTimeout(() => {
          mainImage.src = src;
          mainImage.style.opacity = '1';
        }, 150);

        // Actualizar bordes de los thumbnails
        thumbnails.forEach(t => {
          t.classList.remove('border-black');
          t.classList.add('border-transparent', 'hover:border-border');
        });
        target.classList.remove('border-transparent', 'hover:border-border');
        target.classList.add('border-black');
      }
    });
  });
</script>
