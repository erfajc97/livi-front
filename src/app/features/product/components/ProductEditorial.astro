---
import type { Product } from '@/app/types/global.types';
import CaballitoDivider from '@/app/features/landing/components/shared/CaballitoDivider.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');

// Promesa de calidad — quemada en todos los productos
const TRUST = [
  {
    title: 'Cuero premium',
    desc: 'Trabajamos solo con cuero genuino seleccionado a mano. Cada pieza envejece con carácter y se vuelve más tuya con el tiempo.',
  },
  {
    title: 'Hecho con intención',
    desc: 'Cada costura, herraje y compartimento está pensado para la vida real de los padres modernos: funcional, cómodo y duradero.',
  },
  {
    title: 'Verificado por LIVI',
    desc: 'Cada pieza pasa por control de calidad antes de salir de nuestro taller, para que llegue a tus manos impecable.',
  },
];
---

{/* ── Promesa de calidad (quemado) — fondo sage suave: el beige era color
     de soporte; los bloques editoriales los sostienen sage y celeste (PDF paleta) ── */}
<section class="border-t border-border bg-sage/25 px-6 py-8 md:px-14 md:py-12">
  <div class="mx-auto max-w-3xl text-center">
    <CaballitoDivider tone="burgundy" class="mb-8 w-full max-w-sm mx-auto" />
    <span class="eyebrow">— Promesa LIVI</span>
    <h2 class="mt-3 font-display text-3xl font-light italic leading-[1.05] tracking-[-0.02em] text-text md:text-5xl">
      Cada pieza, verificada.
    </h2>
  </div>

  <div class="mx-auto mt-10 grid max-w-5xl gap-10 md:mt-14 md:grid-cols-3 md:gap-14">
    {TRUST.map((t, i) => (
      <div>
        <span class="font-display text-sm italic text-accent">— {pad(i + 1)}</span>
        <div class="mt-3 h-px w-full bg-border"></div>
        <h3 class="mt-5 font-display text-2xl font-light text-text">{t.title}</h3>
        <p class="mt-4 font-body text-[13px] leading-relaxed text-text-soft">{t.desc}</p>
      </div>
    ))}
  </div>
</section>
