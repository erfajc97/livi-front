---
interface Props {
  image: string;
  text: string;
  slug?: string;
}

const { image, text, slug } = Astro.props;
const href = slug ? `/blog/${slug}` : '/blog';
---

<div class="flex flex-col border border-gray-200 rounded-2xl overflow-hidden">
  <img
    src={image}
    alt="Blog post"
    class="w-full h-52 object-cover"
    loading="lazy"
  />
  <div class="flex flex-col items-center gap-6 p-6 flex-1">
    <p class="font-body text-sm leading-relaxed text-gray-600 text-center line-clamp-3">
      {text}
    </p>
    <a
      href={href}
      class="mt-auto w-full py-2.5 bg-black text-white font-heading text-[13px] font-bold uppercase tracking-wider text-center rounded-full hover:bg-black/80 transition-colors"
    >
      Leer el post
    </a>
  </div>
</div>
