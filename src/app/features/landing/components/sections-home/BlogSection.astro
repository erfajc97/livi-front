---
import BlogCarousel from '@/app/features/blog/components/BlogCarousel';
import { blogService } from '@/app/features/blog/services/blogService';

let posts: any[] = [];
try {
  posts = await blogService.fetchPublishedPosts();
} catch (error) {
  console.error('Error fetching blog posts:', error);
}
---

{posts.length > 0 && (
  <BlogCarousel posts={posts} client:visible />
)}
