---
// Hero LIVI (ref. PDF pág. 14 + mobile home):
// · Mobile: portada a pantalla completa con el copy superpuesto abajo a la
//   izquierda (eyebrow mono + titular serif + botón blanco).
// · Desktop: panel editorial con wordmark + portada a la derecha.
//
// La portada la administra el panel: el primer banner visible de tipo `hero`
// llega por props y puede ser imagen o video. Sin banner (o sin archivo) se
// mantiene la foto de marca de siempre, así la home nunca queda en blanco.
import type { Banner } from '@/app/types/global.types';
import { resolveBannerMedia } from '@/app/helpers/bannerMedia';

interface Props {
  banner?: Banner | null;
}

const { banner = null } = Astro.props;

/** Respaldo cuando el admin todavía no subió una portada. */
const FALLBACK_SRC = '/productos/olivia-espresso-2.jpg';
const FALLBACK_ALT = 'Olivia Maxi Tote en cuero espresso';

const media = resolveBannerMedia(banner, FALLBACK_ALT);

const isVideo = media?.isVideo ?? false;
const alt = media?.alt ?? FALLBACK_ALT;
const poster = media?.poster ?? undefined;
/** Vertical si el admin lo subió; si no, el mismo arte de escritorio. */
const mobileImageSrc = media?.mobileImage ?? media?.src ?? FALLBACK_SRC;
const desktopImageSrc = media?.src ?? FALLBACK_SRC;
const videoSrc = media?.src;
---

{/* ── MOBILE: full-bleed con overlay ── */}
<section class="relative flex h-[86svh] flex-col justify-end overflow-hidden lg:hidden">
  {isVideo && videoSrc ? (
    <video
      data-hero-video
      class="absolute inset-0 h-full w-full object-cover object-center"
      src={videoSrc}
      poster={poster}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
  ) : (
    <img
      src={mobileImageSrc}
      alt={alt}
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
    />
  )}
  {/* Veladura para leer el copy sin tapar la foto */}
  <div class="absolute inset-0 bg-gradient-to-t from-text/70 via-text/20 to-transparent" aria-hidden="true"></div>

  <div class="relative flex flex-col items-start gap-3 px-6 pb-10">
    <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-bg/80">
      — For Modern Parenthood
    </p>
    <h1 class="font-heading text-4xl font-normal leading-[1.05] tracking-[-0.01em] text-bg">
      La pañalera que no<br />lo parece
    </h1>
    <a
      href="/producto/2-olivia-maxi-tote"
      class="mt-3 inline-block bg-bg px-7 py-3.5 font-mono text-[10px] uppercase tracking-[0.22em] text-text transition-colors hover:bg-butter"
    >
      Comprar la tote
    </a>
  </div>
</section>

{/* ── DESKTOP: split editorial ── */}
<section class="hidden min-h-[82vh] grid-cols-2 lg:grid">

  {/* Panel izquierdo: marca + headline */}
  <div class="relative flex flex-col justify-center gap-10 bg-bg px-14 py-0">
    <div class="flex flex-col items-start gap-3">
      <img src="/logo-livi.svg" alt="LIVI" class="h-20 w-auto" />
      <span class="font-heading text-xl italic tracking-[0.08em] text-text-soft">Ecuador</span>
    </div>

    <p class="font-mono text-[11px] uppercase tracking-[0.32em] text-text-muted">
      — For Modern Parenthood
    </p>

    <h1 class="font-heading text-[clamp(2.6rem,5vw,4.6rem)] font-normal uppercase leading-[1.02] tracking-[-0.01em] text-text">
      Family<br />Collection
    </h1>

    <p class="max-w-md font-body text-lg leading-relaxed text-text-soft">
      Pañaleras y mochilas de cuero premium, hechas a mano en Ecuador.
      Diseñadas para llevar más, sin parecer una pañalera.
    </p>

    <div class="flex flex-wrap items-center gap-4">
      <a
        href="/producto/2-olivia-maxi-tote"
        class="inline-block bg-accent px-8 py-4 font-mono text-[11px] uppercase tracking-[0.22em] text-bg transition-colors hover:bg-accent-hover"
      >
        Comprar tote
      </a>
      <a
        href="/nuestra-historia"
        class="inline-block border border-text px-8 py-4 font-mono text-[11px] uppercase tracking-[0.22em] text-text transition-colors hover:border-accent hover:text-accent"
      >
        Conocer LIVI
      </a>
    </div>
  </div>

  {/* Panel derecho: portada editorial (imagen o video) */}
  <div class="relative overflow-hidden bg-bg-alt">
    {isVideo && videoSrc ? (
      <video
        data-hero-video
        class="absolute inset-0 h-full w-full object-cover object-center"
        src={videoSrc}
        poster={poster}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
    ) : (
      <img
        src={desktopImageSrc}
        alt={alt}
        class="absolute inset-0 h-full w-full object-cover object-center"
        fetchpriority="high"
      />
    )}
  </div>

</section>

{/* Sin videos el script no encuentra nada y no hace nada. */}
<script is:inline>
  // 1) `prefers-reduced-motion`: se deja el poster quieto, sin reproducir.
  // 2) El hero existe dos veces (móvil / escritorio): solo se reproduce el
  //    que está visible, para no gastar datos en el oculto.
  (function () {
    var reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Al cruzar el breakpoint cambia cuál de los dos heroes está visible.
    var desktopQuery = window.matchMedia('(min-width: 1024px)');

    function sync() {
      var reduceMotion = reduceMotionQuery.matches;
      var videos = document.querySelectorAll('video[data-hero-video]');
      for (var i = 0; i < videos.length; i++) {
        var video = videos[i];
        if (reduceMotion || video.offsetParent === null) {
          video.removeAttribute('autoplay');
          video.pause();
          video.currentTime = 0;
        } else {
          var started = video.play();
          if (started && typeof started.catch === 'function') started.catch(function () {});
        }
      }
    }

    sync();
    if (typeof desktopQuery.addEventListener === 'function') {
      desktopQuery.addEventListener('change', sync);
      reduceMotionQuery.addEventListener('change', sync);
    }
  })();
</script>
