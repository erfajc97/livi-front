---
/**
 * Botón flotante de WhatsApp — contacto directo con la marca.
 * Burgundy (paleta LIVI), fixed abajo a la derecha; en mobile sube para
 * no chocar con la tab bar (~65px + safe area).
 */
const WHATSAPP_URL = 'https://wa.me/593992305463?text=' + encodeURIComponent('Hola LIVI, tengo una consulta.');
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-24 right-5 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-105 hover:bg-[#1EBE5B] md:bottom-6 md:right-6"
>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2a9.94 9.94 0 0 0-8.5 15.2L2 22l4.95-1.45A9.94 9.94 0 1 0 12 2Zm0 18.1a8.13 8.13 0 0 1-4.15-1.14l-.3-.18-2.94.86.86-2.86-.2-.3A8.15 8.15 0 1 1 12 20.1Zm4.5-6.1c-.25-.13-1.45-.72-1.68-.8-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.96-.14.16-.28.18-.53.06a6.66 6.66 0 0 1-1.96-1.21 7.4 7.4 0 0 1-1.36-1.69c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.13.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.45-.6 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z" />
  </svg>
</a>
