---
import payPhoneSvg from '@/assets/svg/payPhone.svg';
import visaSvg from '@/assets/svg/visa.svg';
import discoverSvg from '@/assets/svg/discover.svg';
import amexSvg from '@/assets/svg/amex.svg';
import dinnersSvg from '@/assets/svg/dinners.svg';
import {
  FOOTER_LINKS_COL1,
  FOOTER_LINKS_COL2,
} from '../../data';

const SOCIAL = [
  { label: 'Instagram', href: '#', primary: true },
  { label: 'TikTok', href: '#' },
  { label: 'Facebook', href: '#' },
];

const PAYMENT_ICONS = [
  { src: payPhoneSvg.src, alt: 'PayPhone' },
  { src: visaSvg.src, alt: 'Visa' },
  { src: dinnersSvg.src, alt: 'Diners Club' },
  { src: amexSvg.src, alt: 'American Express' },
  { src: discoverSvg.src, alt: 'Discover' },
];

const CONTACT = ['+593 99 230 5463', 'contacto@nondecants.com', 'Daule, Ecuador', 'Lun–Sáb · 9–18h'];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-alt text-text-soft">
  <div class="mx-auto max-w-[1600px] px-6 pb-14 pt-24 md:px-14">
    <div class="mb-20 grid grid-cols-1 gap-14 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">

      <!-- Marca -->
      <div>
        <a href="/" aria-label="NönDecants — Inicio" class="inline-block">
          <img src="/logonondecants.png" alt="NönDecants" width={543} height={127} class="h-9 w-auto" />
        </a>
        <p class="mt-6 max-w-[320px] font-body text-[13px] leading-relaxed text-text-soft">
          Casa de fragancias en Ecuador. Sellados, decants y nondecants curados.
          Cada perfume, en el tamaño que necesitas.
        </p>
        <div class="mt-8 flex gap-5">
          {SOCIAL.map((s) => (
            <a
              href={s.href}
              class={`font-body text-[11px] uppercase tracking-[0.2em] ${s.primary ? 'border-b border-border pb-0.5 text-text' : 'text-text-soft hover:text-text'}`}
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Catálogo -->
      <div>
        <span class="eyebrow">Catálogo</span>
        <div class="mt-5 flex flex-col gap-3">
          {FOOTER_LINKS_COL1.map((l) => (
            <a href={l.href} class="font-body text-[13px] text-text-soft transition-colors hover:text-text">{l.label}</a>
          ))}
        </div>
      </div>

      <!-- Casa -->
      <div>
        <span class="eyebrow">Casa</span>
        <div class="mt-5 flex flex-col gap-3">
          {FOOTER_LINKS_COL2.map((l) => (
            <a href={l.href} class="font-body text-[13px] text-text-soft transition-colors hover:text-text">{l.label}</a>
          ))}
        </div>
      </div>

      <!-- Contacto -->
      <div>
        <span class="eyebrow">Contacto</span>
        <div class="mt-5 flex flex-col gap-3">
          {CONTACT.map((c) => (
            <span class="font-body text-[13px] leading-snug text-text-soft">{c}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="h-px bg-border"></div>

    <div class="mt-6 flex flex-col items-start justify-between gap-4 font-body text-[11px] tracking-[0.04em] text-text-muted sm:flex-row sm:items-center">
      <span>© {year} NönDecants · Daule, Ecuador</span>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/terminos" class="transition-colors hover:text-text">Términos</a>
        <a href="/privacidad" class="transition-colors hover:text-text">Privacidad</a>
        <a href="/privacidad" class="transition-colors hover:text-text">Cookies</a>
        <div class="flex items-center gap-2">
          {PAYMENT_ICONS.map((icon) => (
            <img src={icon.src} alt={icon.alt} class="h-5 w-auto opacity-80" />
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
