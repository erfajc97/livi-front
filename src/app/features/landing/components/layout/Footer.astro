---
import { PAYMENT_LOGOS } from '@/app/components/paymentLogos';
import { FOOTER_LINKS_COL1 } from '../../data';

// Cuentas reales de la casa. Sin parámetros de rastreo: así el enlace es
// indexable y no arrastra la sesión de quien lo compartió.
const SOCIAL = [
  { label: 'Instagram', href: 'https://www.instagram.com/nondecants' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@nondecants_' },
];

const WHATSAPP_URL = 'https://wa.me/593992305463';

// Catálogo compartido: mismos logos y alturas que ficha de producto, carrito y combos.
const PAYMENT_ICONS = PAYMENT_LOGOS;

const CONTACT = ['+593 99 230 5463', 'contacto@nondecants.com'];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-alt text-text-soft">
  <!-- pb-28 en mobile: la tab bar es fixed (~65px + safe area) y tapaba la última fila. -->
  <div class="mx-auto max-w-[1600px] px-6 pb-28 pt-10 md:pb-10 md:pt-14 md:px-14">
    <div class="mb-8 grid grid-cols-1 gap-8 md:mb-12 md:gap-14 md:grid-cols-[1.6fr_1fr_1.2fr]">

      <!-- Marca -->
      <div>
        <a href="/" aria-label="NonDecants — Inicio" class="inline-block">
          <img src="/logonondecants.png" alt="NonDecants" width={543} height={127} class="h-9 w-auto" />
        </a>
        <p class="mt-6 max-w-[320px] font-body text-[13px] leading-relaxed text-text-soft">
          Perfumes auténticos al mejor precio. Prueba en decant antes de
          comprometerte con el frasco entero, y si no está en nuestro catálogo,
          lo conseguimos por ti en tiempo récord.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          {SOCIAL.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="me noopener"
              class="font-body text-[11px] uppercase tracking-[0.2em] text-text-soft transition-colors hover:text-text"
            >
              {s.label}
            </a>
          ))}
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener"
            aria-label="Escríbenos por WhatsApp"
            class="inline-flex items-center gap-2 border border-border px-3 py-1.5 font-body text-[11px] uppercase tracking-[0.2em] text-text-soft transition-colors hover:border-text hover:text-text"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a9.94 9.94 0 0 0-8.5 15.2L2 22l4.95-1.45A9.94 9.94 0 1 0 12 2Zm0 18.1a8.13 8.13 0 0 1-4.15-1.14l-.3-.18-2.94.86.86-2.86-.2-.3A8.15 8.15 0 1 1 12 20.1Zm4.5-6.1c-.25-.13-1.45-.72-1.68-.8-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.96-.14.16-.28.18-.53.06a6.66 6.66 0 0 1-1.96-1.21 7.4 7.4 0 0 1-1.36-1.69c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.13.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.45-.6 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z" />
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Explora -->
      <div>
        <span class="eyebrow">Explora</span>
        <div class="mt-5 flex flex-col gap-3">
          {FOOTER_LINKS_COL1.map((l) => (
            <a href={l.href} class="font-body text-[13px] text-text-soft transition-colors hover:text-text">{l.label}</a>
          ))}
        </div>
      </div>

      <!-- Contacto: el teléfono abre el chat, el correo abre el cliente de mail -->
      <div>
        <span class="eyebrow">Contacto</span>
        <div class="mt-5 flex flex-col items-start gap-3">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 font-body text-[13px] leading-snug text-text-soft transition-colors hover:text-text"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a9.94 9.94 0 0 0-8.5 15.2L2 22l4.95-1.45A9.94 9.94 0 1 0 12 2Zm0 18.1a8.13 8.13 0 0 1-4.15-1.14l-.3-.18-2.94.86.86-2.86-.2-.3A8.15 8.15 0 1 1 12 20.1Zm4.5-6.1c-.25-.13-1.45-.72-1.68-.8-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.96-.14.16-.28.18-.53.06a6.66 6.66 0 0 1-1.96-1.21 7.4 7.4 0 0 1-1.36-1.69c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.13.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.45-.6 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z" />
            </svg>
            {CONTACT[0]}
          </a>
          <a
            href={`mailto:${CONTACT[1]}`}
            class="font-body text-[13px] leading-snug text-text-soft transition-colors hover:text-text"
          >
            {CONTACT[1]}
          </a>
        </div>
      </div>
    </div>

    <!-- Medios de pago: bloque propio bajo las columnas. En la barra legal
         competían con los enlaces y quedaban apretados contra el borde. -->
    <div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2.5 md:gap-x-4 md:gap-y-3">
      {PAYMENT_ICONS.map((icon) => (
        <img
          src={icon.src}
          alt={icon.alt}
          title={icon.alt}
          loading="lazy"
          class:list={['w-auto object-contain', icon.cls]}
        />
      ))}
    </div>

    <div class="h-px bg-border"></div>

    <div class="mt-6 flex flex-col items-start justify-between gap-4 font-body text-[11px] tracking-[0.04em] text-text-muted sm:flex-row sm:items-center">
      <span>© {year} NonDecants · Ecuador</span>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/terminos" class="transition-colors hover:text-text">Términos</a>
        <a href="/privacidad" class="transition-colors hover:text-text">Privacidad</a>
        <a href="/cookies" class="transition-colors hover:text-text">Cookies</a>
        <a href="/faq" class="transition-colors hover:text-text">FAQ</a>
      </div>
    </div>
  </div>
</footer>
