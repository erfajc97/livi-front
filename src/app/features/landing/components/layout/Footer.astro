---
import { PAYMENT_LOGOS } from '@/app/components/paymentLogos';
import { FOOTER_LINKS_COL1 } from '../../data';

const SOCIAL = [
  { label: 'Instagram', href: '#', primary: true },
  { label: 'TikTok', href: '#' },
  { label: 'Facebook', href: '#' },
];

// Catálogo compartido: mismos logos y alturas que ficha de producto, carrito y combos.
const PAYMENT_ICONS = PAYMENT_LOGOS;

const CONTACT = ['+593 99 230 5463', 'contacto@nondecants.com'];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-alt text-text-soft">
  <!-- pb-28 en mobile: la tab bar es fixed (~65px + safe area) y tapaba la última fila. -->
  <div class="mx-auto max-w-[1600px] px-6 pb-28 pt-10 md:pb-10 md:pt-14 md:px-14">
    <div class="mb-8 grid grid-cols-1 gap-8 md:mb-12 md:gap-14 md:grid-cols-[1.6fr_1fr_1.2fr]">

      <!-- Marca -->
      <div>
        <a href="/" aria-label="NonDecants — Inicio" class="inline-block">
          <img src="/logonondecants.png" alt="NonDecants" width={543} height={127} class="h-9 w-auto" />
        </a>
        <p class="mt-6 max-w-[320px] font-body text-[13px] leading-relaxed text-text-soft">
          Perfumes auténticos al mejor precio. Prueba en decant antes de
          comprometerte con el frasco entero, y si no está en nuestro catálogo,
          lo conseguimos por ti en tiempo récord.
        </p>
        <div class="mt-8 flex gap-5">
          {SOCIAL.map((s) => (
            <a
              href={s.href}
              class={`font-body text-[11px] uppercase tracking-[0.2em] ${s.primary ? 'border-b border-border pb-0.5 text-text' : 'text-text-soft hover:text-text'}`}
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Explora -->
      <div>
        <span class="eyebrow">Explora</span>
        <div class="mt-5 flex flex-col gap-3">
          {FOOTER_LINKS_COL1.map((l) => (
            <a href={l.href} class="font-body text-[13px] text-text-soft transition-colors hover:text-text">{l.label}</a>
          ))}
        </div>
      </div>

      <!-- Contacto -->
      <div>
        <span class="eyebrow">Contacto</span>
        <div class="mt-5 flex flex-col gap-3">
          {CONTACT.map((c) => (
            <span class="font-body text-[13px] leading-snug text-text-soft">{c}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="h-px bg-border"></div>

    <div class="mt-6 flex flex-col items-start justify-between gap-4 font-body text-[11px] tracking-[0.04em] text-text-muted sm:flex-row sm:items-center">
      <span>© {year} NonDecants · Daule, Ecuador</span>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/terminos" class="transition-colors hover:text-text">Términos</a>
        <a href="/privacidad" class="transition-colors hover:text-text">Privacidad</a>
        <a href="/privacidad" class="transition-colors hover:text-text">Cookies</a>
        <a href="/faq" class="transition-colors hover:text-text">FAQ</a>
        <div class="flex flex-wrap items-center gap-2">
          {PAYMENT_ICONS.map((icon) => (
            <img
              src={icon.src}
              alt={icon.alt}
              title={icon.alt}
              class:list={['w-auto object-contain', icon.cls]}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
