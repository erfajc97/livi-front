---
import { PAYMENT_LOGOS } from '@/app/components/paymentLogos';
import { FOOTER_LINKS_COL1 } from '../../data';
import CaballitoDivider from '../shared/CaballitoDivider.astro';

// Cuentas de la marca. Sin parámetros de rastreo: así el enlace es
// indexable y no arrastra la sesión de quien lo compartió.
const SOCIAL = [
  { label: 'Instagram', href: 'https://www.instagram.com/livi.ec' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@livi.ec' },
];

const WHATSAPP_URL = 'https://wa.me/593992305463';

// Catálogo compartido: mismos logos y alturas que ficha de producto y carrito.
const PAYMENT_ICONS = PAYMENT_LOGOS;

const CONTACT = ['+593 99 230 5463', 'contacto@livi.ec'];

const year = new Date().getFullYear();

// Footer reversado (ref. PDF identidad): burgundy con el wordmark en butter.
const INK = 'text-[#F5EFC6]';        // butter
const INK_SOFT = 'text-[#F5EFC6]/75';
const INK_MUTED = 'text-[#F5EFC6]/55';
const LINE = 'bg-[#F5EFC6]/25';
const HOVER = 'transition-colors hover:text-[#F5EFC6]';
---

<footer class="bg-accent text-[#F5EFC6]">
  <!-- pb-28 en mobile: la tab bar es fixed (~65px + safe area) y tapaba la última fila. -->
  <div class="mx-auto max-w-[1600px] px-6 pb-28 pt-10 md:pb-10 md:pt-14 md:px-14">

    <!-- Wordmark reversado + caballito: cierre editorial de la página -->
    <div class="mb-10 flex flex-col items-center gap-6 md:mb-14">
      <a href="/" aria-label="LIVI — Inicio" class="inline-block">
        <img src="/logo-livi-reversed.svg" alt="LIVI Ecuador" width={260} height={96} class="h-16 w-auto md:h-20" />
      </a>
      <CaballitoDivider tone="butter" class="w-full max-w-md" />
      <p class="font-mono text-[10px] uppercase tracking-[0.32em] text-[#F5EFC6]/60">
        For Modern Parenthood
      </p>
    </div>

    <div class="mb-8 grid grid-cols-1 gap-8 md:mb-12 md:gap-14 md:grid-cols-[1.6fr_1fr_1.2fr]">

      <!-- Marca -->
      <div>
        <p class={`max-w-[320px] font-body text-[13px] leading-relaxed ${INK_SOFT}`}>
          Pañaleras y mochilas de cuero premium que no parecen de bebé.
          Diseñadas en Ecuador para la paternidad moderna: piezas para tu
          vida, no solo para la etapa.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          {SOCIAL.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="me noopener"
              class={`font-body text-[11px] uppercase tracking-[0.2em] ${INK_SOFT} ${HOVER}`}
            >
              {s.label}
            </a>
          ))}
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener"
            aria-label="Escríbenos por WhatsApp"
            class={`inline-flex items-center gap-2 border border-[#F5EFC6]/35 px-3 py-1.5 font-body text-[11px] uppercase tracking-[0.2em] ${INK_SOFT} transition-colors hover:border-[#F5EFC6] hover:text-[#F5EFC6]`}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a9.94 9.94 0 0 0-8.5 15.2L2 22l4.95-1.45A9.94 9.94 0 1 0 12 2Zm0 18.1a8.13 8.13 0 0 1-4.15-1.14l-.3-.18-2.94.86.86-2.86-.2-.3A8.15 8.15 0 1 1 12 20.1Zm4.5-6.1c-.25-.13-1.45-.72-1.68-.8-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.96-.14.16-.28.18-.53.06a6.66 6.66 0 0 1-1.96-1.21 7.4 7.4 0 0 1-1.36-1.69c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.13.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.45-.6 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z" />
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Explora -->
      <div>
        <span class={`font-body text-[0.625rem] uppercase tracking-[0.24em] ${INK_MUTED}`}>Explora</span>
        <div class="mt-5 flex flex-col gap-3">
          {FOOTER_LINKS_COL1.map((l) => (
            <a href={l.href} class={`font-body text-[13px] ${INK_SOFT} ${HOVER}`}>{l.label}</a>
          ))}
        </div>
      </div>

      <!-- Contacto: el teléfono abre el chat, el correo abre el cliente de mail -->
      <div>
        <span class={`font-body text-[0.625rem] uppercase tracking-[0.24em] ${INK_MUTED}`}>Contacto</span>
        <div class="mt-5 flex flex-col items-start gap-3">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener"
            class={`inline-flex items-center gap-2 font-body text-[13px] leading-snug ${INK_SOFT} ${HOVER}`}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a9.94 9.94 0 0 0-8.5 15.2L2 22l4.95-1.45A9.94 9.94 0 1 0 12 2Zm0 18.1a8.13 8.13 0 0 1-4.15-1.14l-.3-.18-2.94.86.86-2.86-.2-.3A8.15 8.15 0 1 1 12 20.1Zm4.5-6.1c-.25-.13-1.45-.72-1.68-.8-.22-.08-.39-.13-.55.13-.16.25-.63.8-.77.96-.14.16-.28.18-.53.06a6.66 6.66 0 0 1-1.96-1.21 7.4 7.4 0 0 1-1.36-1.69c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.44-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.13.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.19 1.1.16 1.52.1.46-.07 1.45-.6 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.11-.22-.17-.47-.29Z" />
            </svg>
            {CONTACT[0]}
          </a>
          <a
            href={`mailto:${CONTACT[1]}`}
            class={`font-body text-[13px] leading-snug ${INK_SOFT} ${HOVER}`}
          >
            {CONTACT[1]}
          </a>
        </div>
      </div>
    </div>

    <!-- Medios de pago: chips butter para que los logos se lean sobre burgundy. -->
    <div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2.5 md:gap-x-4 md:gap-y-3">
      {PAYMENT_ICONS.map((icon) => (
        <span class="inline-flex items-center rounded-sm bg-[#F5EFC6] px-2 py-1">
          <img
            src={icon.src}
            alt={icon.alt}
            title={icon.alt}
            loading="lazy"
            class:list={['w-auto object-contain', icon.cls]}
          />
        </span>
      ))}
    </div>

    <div class={`h-px ${LINE}`}></div>

    <div class={`mt-6 flex flex-col items-start justify-between gap-4 font-body text-[11px] tracking-[0.04em] ${INK_MUTED} sm:flex-row sm:items-center`}>
      <span>© {year} LIVI · Ecuador — Cuero genuino, hecho por artesanos ecuatorianos</span>
      <div class="flex flex-wrap items-center gap-5">
        <a href="/terminos" class={HOVER}>Términos</a>
        <a href="/privacidad" class={HOVER}>Privacidad</a>
        <a href="/cookies" class={HOVER}>Cookies</a>
        <a href="/faq" class={HOVER}>FAQ</a>
      </div>
    </div>
  </div>
</footer>
