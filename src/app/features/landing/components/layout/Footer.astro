---
import FooterLink from '../FooterLink.astro';
import logoSvg from '@/assets/logo.svg';
import payPhoneSvg from '@/assets/svg/payPhone.svg';
import visaSvg from '@/assets/svg/visa.svg';
import discoverSvg from '@/assets/svg/discover.svg';
import amexSvg from '@/assets/svg/amex.svg';
import dinnersSvg from '@/assets/svg/dinners.svg';
import faceSvg from '@/assets/svg/face.svg';
import instaSvg from '@/assets/svg/insta.svg';
import ticktockSvg from '@/assets/svg/ticktock.svg';
import {
  FOOTER_LINKS_COL1,
  FOOTER_LINKS_COL2,
} from '../../data';

const SOCIAL_ICONS = [
  { src: faceSvg.src, alt: 'Facebook', href: '#' },
  { src: instaSvg.src, alt: 'Instagram', href: '#' },
  { src: ticktockSvg.src, alt: 'TikTok', href: '#' },
];

const PAYMENT_ICONS = [
  { src: payPhoneSvg.src, alt: 'PayPhone' },
  { src: visaSvg.src, alt: 'Visa' },
  { src: dinnersSvg.src, alt: 'Diners Club' },
  { src: amexSvg.src, alt: 'American Express' },
  { src: discoverSvg.src, alt: 'Discover' },
];

const year = new Date().getFullYear();
---

<footer class="bg-[url('/footer.png')] bg-cover bg-center bg-no-repeat border-t border-border relative">
  <div class="absolute inset-0 bg-black/70"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-12 relative z-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">

      <!-- Columna marca -->
      <div class="md:col-span-1">
        <a href="/" aria-label="NönDecants — Inicio">
          <img src={logoSvg.src} alt="NönDecants" class="w-40 h-auto" />
        </a>
        <p class="text-[--color-text-muted] text-lg leading-relaxed mt-2 max-w-xs">
          Plataforma especializada en la venta de perfumes sellados, decants y nondecants en Ecuador.
          Cada fragancia, en el tamaño que necesitas.
        </p>

        <!-- Social -->
        <div class="flex items-center gap-4 mt-6">
          {SOCIAL_ICONS.map(s => (
            <a href={s.href} aria-label={s.alt} class="hover:opacity-80 transition-opacity">
              <img src={s.src} alt={s.alt} class="w-7 h-7" />
            </a>
          ))}
        </div>
      </div>

      <!-- Links col 1 -->
      <div>
        <p class="font-heading text-lg uppercase tracking-[0.2em] text-[--color-text] mb-4">
          Links
        </p>
        <ul class="space-y-2">
          {FOOTER_LINKS_COL1.map(l => (
            <FooterLink href={l.href} label={l.label} />
          ))}
        </ul>
      </div>

      <!-- Links col 2 -->
      <div>
        <p class="font-heading text-lg uppercase tracking-[0.2em] text-[--color-text] mb-4">
          Links
        </p>
        <ul class="space-y-2">
          {FOOTER_LINKS_COL2.map(l => (
            <FooterLink href={l.href} label={l.label} />
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <p class="font-heading text-lg uppercase tracking-[0.2em] text-[--color-text] mb-4">
          Contacto
        </p>
        <ul class="space-y-2 text-lg text-[--color-text-muted]">
          <li class="flex items-start gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 shrink-0 text-[--color-accent]">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.65 3.18 2 2 0 0 1 3.62 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            +593 99 000 0000
          </li>
          <li class="flex items-start gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 shrink-0 text-[--color-accent]">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            contacto@nondecants.ec
          </li>
          <li class="flex items-start gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 shrink-0 text-[--color-accent]">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            Daule, Ecuador
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="border-t border-[--color-border]" />
    <div class="py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p class="text-sm sm:text-base text-[--color-text-muted]">
        © {year} NönDecants. All rights reserved. Made by Shopwishi.
      </p>
      <!-- Payment badges -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        {PAYMENT_ICONS.map(icon => (
          <img
            src={icon.src}
            alt={icon.alt}
            class="h-6 sm:h-8 w-auto"
          />
        ))}
      </div>
    </div>
  </div>
</footer>
