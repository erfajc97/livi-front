---
interface Props {
  title: string;
  subtitle?: string;
  accent?: string;
}

const { title, subtitle, accent } = Astro.props as Props;
---

<div class="text-center mb-10">
  <h2 class="font-heading text-3xl md:text-4xl text-[--color-text] uppercase tracking-wider">
    {accent ? (
      <>
        {title}{' '}
        <span class="text-[--color-accent]">{accent}</span>
      </>
    ) : (
      title
    )}
  </h2>
  {subtitle && (
    <p class="mt-3 text-[--color-text-muted] text-sm max-w-md mx-auto">
      {subtitle}
    </p>
  )}
  <div class="mt-4 mx-auto w-16 h-px bg-[--color-accent]" />
</div>
