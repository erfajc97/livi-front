---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Imagen de la vista previa al compartir. Ruta absoluta desde la raíz. */
  ogImage?: string;
}

const {
  title = 'NönDecants — Perfumes sellados, decants y nondecants',
  description = 'Compra perfumes sellados, decants y nondecants en Ecuador. Envíos a todo el país vía Servientrega.',
  ogImage = '/og-image.jpg',
} = Astro.props;

// Texto que ve quien recibe el enlace por WhatsApp: WhatsApp lee og:description,
// no la meta description normal, y necesita URLs absolutas para la imagen.
const SHARE_DESCRIPTION = 'Perfumes sellados y decants 100% originales';

// WhatsApp y varias apps renderizan la diéresis con una tipografía que no la
// trae y sale un caracter roto, así que la tarjeta al compartir dice
// "NonDecants" en texto plano. En la página el nombre sigue con ö.
const plainBrand = (text: string) => text.replace(/ö/g, 'o').replace(/Ö/g, 'O');
const shareTitle = plainBrand(title);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />

    <!-- Vista previa al compartir (WhatsApp, Facebook, Telegram) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NonDecants" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={SHARE_DESCRIPTION} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:secure_url" content={ogImageUrl.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NonDecants — Perfumes sellados y decants 100% originales" />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={SHARE_DESCRIPTION} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts · Atelier: Cormorant Garamond (display serif) + DM Sans (cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Sin AppProviders aquí: cada island gestiona su propio QueryClientProvider
         con el singleton de queryClient.ts. Zustand no necesita provider. -->
    <slot />
  </body>
</html>
